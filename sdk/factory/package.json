{
  "name": "@fastgpt-plugin/sdk-factory",
  "version": "1.2.0-beta.3",
  "description": "TypeScript factory SDK for authoring FastGPT Plugin tools, tool suites and moderation plugins.",
  "keywords": [
    "fastgpt",
    "fastgpt-plugin",
    "sdk",
    "tool",
    "moderation",
    "typescript"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/tar-stream": "^3.1.5",
    "tsdown": "catalog:",
    "undici": "^7.29.1"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "buffer": "^6.0.3",
    "tar-stream": "^3.2.2",
    "tsdown": "catalog:"
  }
}

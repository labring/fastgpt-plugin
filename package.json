{
  "name": "fastgpt-plugins",
  "version": "0.2.0",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "prepare": "node scripts/prepare-husky.mjs",
    "postinstall": "pnpm build:sdk-factory",
    "lint": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "build:pkg": "pnpm tsc && pnpm --filter modules/tool build",
    "build:sdk-client": "pnpm --filter @fastgpt-plugin/sdk-client build",
    "build:sdk-factory": "pnpm --filter @fastgpt-plugin/sdk-factory build",
    "build:server": "pnpm --filter @fastgpt-plugin/server build",
    "build:connection-gateway": "pnpm --filter @fastgpt-plugin/connection-gateway build",
    "build:cli": "pnpm --filter @fastgpt-plugin/cli build",
    "build:debug-runtime-monitor": "pnpm --filter @fastgpt-plugin/debug-runtime-monitor build",
    "dev:cli": "pnpm --filter @fastgpt-plugin/cli dev",
    "dev:connection-gateway": "pnpm --filter @fastgpt-plugin/connection-gateway dev",
    "dev:server": "pnpm --filter @fastgpt-plugin/server dev",
    "dev:debug-runtime-monitor": "pnpm --filter @fastgpt-plugin/debug-runtime-monitor dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^1.2.0",
    "@inquirer/prompts": "^7.5.3",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "chalk": "^5.4.1",
    "date-fns": "^4.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "husky": "^8.0.3",
    "json5": "^2.2.3",
    "lint-staged": "^16.4.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.29.1",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": "2.8.0",
      "@opentelemetry/otlp-transformer>protobufjs": "7.6.5",
      "@scalar/types>nanoid": "5.1.16",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "minimatch@10>brace-expansion": "5.0.9",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@9>brace-expansion": "2.1.4"
    }
  },
  "lint-staged": {
    "**/*.{ts,js,mjs,cjs}": "eslint --fix"
  }
}
